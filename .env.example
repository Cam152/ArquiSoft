# Copia este archivo a .env para cambiar los valores por defecto (opcional).
# Todas las variables tienen un valor por defecto en docker-compose.yml.

# --- Elections DB y Election Service ---
ELECTIONS_DB_USER=elections
ELECTIONS_DB_PASSWORD=elections
ELECTIONS_DB_NAME=elections
ADMIN_API_KEY=dev-admin-key
SEED_DATA=true

# --- Voters DB y Voter Service ---
VOTERS_DB_USER=voters
VOTERS_DB_PASSWORD=voters
VOTERS_DB_NAME=voters

# --- Auth Service ---
# Mínimo 32 caracteres. Cámbiala fuera de las pruebas.
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef

# --- Gateway, Voter Service y Vote Service (llamadas entre servicios) ---
SERVICE_API_KEY=dev-service-key

# --- Audit DB y Audit Service ---
# Usuario y clave de agr-audit-db (MongoDB). Solo los conoce agr-audit-lo.
# Si cambian la clave, usen solo letras y números (va dentro de una URL).
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=audit
AUDIT_MONGO_DB=audit

# --- Votes DB y Vote Service ---
# Usuario y clave de agr-votes-db (MongoDB). Solo los conoce agr-vote-lo.
# Si cambian la clave, usen solo letras y números (va dentro de una URL).
VOTES_DB_USER=votes
VOTES_DB_PASSWORD=votes
VOTES_MONGO_DB=votes

# --- Broker (agr-broker-as) ---
# Usuario y clave de RabbitMQ y de su consola (http://localhost:15672).
# Solo letras y números (va dentro de la URL AMQP de los servicios).
BROKER_USER=agora
BROKER_PASSWORD=agora

# --- CORS (Election Service y Vote Service) ---
CORS_ORIGINS=http://localhost:3000

# --- Front-end: URLs de los servicios tal como las ve el navegador (se fijan al compilar) ---
VITE_ELECTION_API_URL=http://localhost:8000
VITE_VOTER_API_URL=http://localhost:8001
VITE_VOTE_API_URL=http://localhost:8002
