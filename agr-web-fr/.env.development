# Valores para `npm run dev` fuera de Docker (el servidor de Next.js corre en tu equipo).
# Desde S2 el gateway ya no publica el puerto 8080, así que para desarrollar la web
# fuera de Docker hay que publicarlo solo en tu máquina con un override local
# (docker-compose.override.yml, que no se sube):
#
#   services:
#     agr-gateway-or:
#       ports: ["127.0.0.1:8080:8080"]
#
# El navegador llama directo a localhost:8080 (otro origen), por eso el gateway
# debe aceptar ese origen: CORS_ORIGINS=https://localhost,http://localhost:3000 en .env.
GATEWAY_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
